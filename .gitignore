# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
*.egg-info/
dist/

# Gradle and Android build output. Also catches Python build/ directories.
build/
.gradle/

# IDE
.idea/

# Frame logs written by the recording tap at runtime. Recordings are large and
# are shared as files, not through git.
server/frame_logs/
# Scene passes cached by python -m nav.evaluation --cached.
server/.replay_cache/
# Screenshots the browser tests write. Copied into a task's records by hand when they are wanted.
server/tests/screenshots/

# Android Studio writes the SDK path here per machine.
local.properties

# Kotlin 2 session data beside each Gradle project.
.kotlin/
